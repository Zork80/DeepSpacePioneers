# This .gitignore file is placed at the root of the Unity project directory
# Based on the official GitHub Unity .gitignore template

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when on the same level than an ignored directory
/[Aa]ssets/[Ll]ibrary/
/[Aa]ssets/[Tt]emp/
/[Aa]ssets/[Oo]bj/
/[Aa]ssets/[Bb]uild/
/[Aa]ssets/[Bb]uilds/
/[Aa]ssets/[Ll]ogs/
/[Aa]ssets/[Uu]ser[Ss]ettings/
/[Aa]ssets/[Mm]emoryCaptures/
/[Aa]ssets/[Rr]ecordings/

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE and editor files
.vs/
.idea/
.vscode/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Standalone builds and binaries
*.apk
*.aab
*.unitypackage
*.app
*.x86
*.x86_64
*.so
*.debug
*_Data/
DeepSpacePioneers
DeepSpacePioneers*

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# OS generated
.DS_Store
Thumbs.db
.aider*

# Python
__pycache__/
*.pyc

# Agent Bridge runtime files
agent_bridge*/*.json
agent_bridge*/*.tmp
agent_bridge*/*/*.json
agent_bridge*/*/*.tmp

# Build outputs
[Bb]uild/
[Bb]uilds/
*_BurstDebugInformation_DoNotShip/
libdecor*.so*

# Logs and test results
*.log
*_results.json
test_bridge/
play_vs_bot.sh
Assets/Resources/PerformanceTestRun*.json*

